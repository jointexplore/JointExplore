{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Container Manager",
  "version": "1.0.0",
  "identifier": "com.desktopcontainer.manager",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Portable web app container manager",
    "longDescription": "Manage and launch websites in separate desktop windows."
  }
}
